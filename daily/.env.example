# --- Akun X untuk fetch harian (pakai akun cadangan; JANGAN yang dipakai job SSK) ---
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_PROXY=            # http://user:pass@host:port — WAJIB (IP Railway = datacenter)
# --- Telegram (opsional, untuk notifikasi update harian) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Google Sheets (dataset durable) ---
GOOGLE_SA_JSON=          # isi JSON service account (satu baris) atau path file
SHEET_ID=                # id Google Sheet; bagikan ke email service account sbg Editor
# --- lain ---
REQ_PER_WINDOW=35
REFRESH_KEY=             # kunci rahasia untuk memicu /refresh?key=... manual
FETCH_ENABLED=1          # 0 = hanya tampilkan dashboard, tidak menarik X
# DATA_DIR=/data         # pasang Railway Volume di /data agar data harian persist
