# --- Akun X untuk fetch harian (pakai akun cadangan; JANGAN yang dipakai job SSK) ---
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_PROXY=            # http://user:pass@host:port — WAJIB (IP Railway = datacenter)
# --- Telegram (opsional, untuk notifikasi update harian) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Google Sheets (dataset durable) ---
GOOGLE_SA_JSON=          # isi JSON service account (satu baris) atau path file
SHEET_ID=                # id Google Sheet; bagikan ke email service account sbg Editor
# --- Instagram: follower (crawler publik, tanpa login) + engagement per-post (instagrapi, login) ---
IG_SESSIONID=            # cookie akun CADANGAN IG → AKTIFKAN fetch post (likes/komentar/views Reel).
                         #   Kosong = tab IG tetap jalan utk follower/post count saja (tanpa engagement).
IG_PROXY=                # http://user:pass@host:port — SANGAT disarankan! IP Railway=datacenter,
                         #   IG cepat mem-flag akun cadangan tanpa proxy residensial.
IG_POST_MAX=30           # post per member utk engagement; 0 = SEMUA post (lebih berat & berisiko)
# IG_CSRFTOKEN= / IG_DS_USER_ID=   # opsional, menambah keandalan sesi
# --- lain ---
REQ_PER_WINDOW=35
REFRESH_KEY=             # kunci rahasia: /refresh (X), /refresh_ig (follower IG), /refresh_ig_posts (post IG)
FETCH_ENABLED=1          # 0 = hanya tampilkan dashboard, tidak menarik apa pun
# DATA_DIR=/data         # pasang Railway Volume di /data agar data harian persist
