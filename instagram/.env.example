# --- Dashboard Instagram JKT48 ---
# Tidak butuh login/akun: fetch pakai UA crawler publik (og-tag + JSON SSR eksak).
REFRESH_KEY=            # kunci rahasia untuk /refresh?key=... (tarik manual)
FETCH_ENABLED=1         # 0 = hanya tampilkan dashboard, tidak menarik
IG_PAUSE=1.2            # jeda antar-akun (detik); naikkan bila kena rate-limit
# DATA_DIR=/data        # pasang Railway Volume di /data agar snapshot harian persist
