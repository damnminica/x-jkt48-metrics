# Satu file per akun X cadangan. VPS: simpan sebagai .env.job.<nama> (chmod 600), jalankan
#   sudo systemctl enable --now jkt48-x-job@<nama>
# Railway: isi variabel yang sama di dashboard service, plus WORKER=jobs.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# http://user:pass@host:port atau socks5://... — WAJIB (worker diam kalau kosong); sebaiknya sesi berbeda per akun
TWITTER_PROXY=
REQUIRE_PROXY=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JOB_FILE=jobs/ssk2024.json
# urutan & filter mode (member,hashtag,mention), atau TASKS=id1,id2 untuk memilih task tertentu
MODES=member,hashtag
# Koordinasi beberapa akun:
#  - kosongkan SHARD (default) = ANTREAN BERSAMA: semua akun di disk yang sama (mis. 2 instance di 1 VPS)
#    mengambil task bergiliran; task yang sudah diambil satu akun tidak dikerjakan akun lain.
#  - isi SHARD=k/n hanya kalau worker berada di disk berbeda (mis. 2 service Railway): pembagian tetap.
SHARD=
# SAMA untuk semua akun dalam satu job (antrean, data & hash fans dibagi lewat folder DATA_DIR/RUN_ID)
RUN_ID=ssk2024
# Mode antrean: boleh kosong (salt dibuat sekali & dibagi lewat file). Mode SHARD n>1: WAJIB & sama untuk semua akun.
# Jangan diganti setelah job berjalan.
HASH_SALT=
REQ_PER_WINDOW=35
